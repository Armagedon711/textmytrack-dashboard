# Copy this file to .env.local and fill in your values.
# .env.local is not committed (see .gitignore).

# Required for adding songs from a YouTube playlist (Add Song → paste playlist URL).
# Get a key: https://console.cloud.google.com/ → APIs & Services → Credentials → Create API key
# Enable "YouTube Data API v3" for the project.
YOUTUBE_API_KEY=your_youtube_api_key_here
